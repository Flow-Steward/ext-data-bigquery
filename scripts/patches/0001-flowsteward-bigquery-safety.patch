+	client, err := bigqueryapi.NewClient(context.Background(), "test-project", option.WithHTTPClient(&http.Client{Transport: transport}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close() })
+	source := &bqsource.Source{Config: bqsource.Config{Project: "test-project"}, Client: client, AllowedDatasets: map[string]struct{}{"test-project.workflow": {}, "other-project.workflow": {}}}
+	cfg := Config{ConfigBase: tools.ConfigBase{Name: "metadata", Description: "bounded metadata"}, Source: "s"}
+	tool, err := cfg.Initialize(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	actual := tool.(Tool)
+	return &actual, source, calls
+}
+
+func workflowParams(project, dataset string) parameters.ParamValues {
+	return parameters.ParamValues{{Name: "project", Value: project}, {Name: "dataset", Value: dataset}, {Name: "table", Value: "people"}}
+}
+
+func TestFlowStewardMetadataScopeBeforeWire(t *testing.T) {
+	tool, provider, calls := workflowFixture(t, func(*http.Request, int) string { t.Fatal("scope escaped"); return "" })
+	for _, params := range []parameters.ParamValues{workflowParams("other-project", "workflow"), workflowParams("test-project", "forbidden")} {
+		if _, err := tool.Invoke(workflowContext(t), provider, params, ""); err == nil {
+			t.Fatal("out of scope metadata accepted")
+		}
+	}
+	if *calls != 0 {
+		t.Fatal("out of scope request reached Google")
+	}
+}
+
+func workflowTables(count int, next string) string {
+	tables := make([]string, 0, count)
+	for i := 0; i < count; i++ {
+		tables = append(tables, fmt.Sprintf(`{"tableReference":{"projectId":"test-project","datasetId":"workflow","tableId":"t%d"}}`, i))
+	}
+	return `{"tables":[` + strings.Join(tables, ",") + `],"nextPageToken":"` + next + `"}`
+}
+func TestFlowStewardBoundedMetadataWire(t *testing.T) {
+	for _, count := range []int{0, 2, 100, 101} {
+		t.Run(fmt.Sprint(count), func(t *testing.T) {
+			tool, provider, calls := workflowFixture(t, func(r *http.Request, n int) string {
+				if n != 1 {
+					t.Fatal("overflow made an extra page request")
+				}
+				if r.URL.Path != "/bigquery/v2/projects/test-project/datasets/workflow/tables" || r.URL.Query().Get("maxResults") != "101" {
+					t.Fatalf("unbounded catalog request: %s", r.URL)
+				}
+				next := ""
+				if count == 101 {
+					next = "must-not-follow"
+				}
+				return workflowTables(count, next)
+			})
+			result, err := tool.Invoke(workflowContext(t), provider, workflowParams("test-project", "workflow"), "")
+			if count == 101 {
+				if err == nil || result != nil {
+					t.Fatal("oversized schema silently truncated")
+				}
+			} else {
+				if err != nil {
+					t.Fatal(err)
+				}
+				if count > 0 && len(result.([]any)) != count {
+					t.Fatal("metadata rows lost")
+				}
+			}
+			if *calls != 1 {
+				t.Fatalf("requests=%d", *calls)
+			}
+		})
+	}
+}
+func TestFlowStewardPaginationBound(t *testing.T) {
+	tool, provider, calls := workflowFixture(t, func(r *http.Request, n int) string {
+		if n > 2 {
+			t.Fatal("unexpected extra page")
+		}
+		if n == 1 {
+			return workflowTables(100, "next")
+		}
+		if r.URL.Query().Get("pageToken") != "next" {
+			t.Fatal("pagination token missing")
+		}
+		return workflowTables(1, "must-not-follow")
+	})
+	if result, err := tool.Invoke(workflowContext(t), provider, workflowParams("test-project", "workflow"), ""); err == nil || result != nil {
+		t.Fatal("paginated overflow accepted")
+	}
+	if *calls != 2 {
+		t.Fatalf("requests=%d", *calls)
+	}
+}
+
+func workflowContext(t *testing.T) context.Context {
+	t.Helper()
+	ctx, err := testutils.ContextWithNewLogger()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ctx
+}
