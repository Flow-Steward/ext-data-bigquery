+func workflowAffectedRows(stats *bigqueryapi.QueryStatistics, statementType string) (int64, bool) {
+ if stats == nil || statementType == "SELECT" { return 0, false }
+ if stats.DMLStats != nil { return stats.DMLStats.InsertedRowCount + stats.DMLStats.UpdatedRowCount + stats.DMLStats.DeletedRowCount, true }
+ if statementType == "MERGE" { return 0, false }
+ return stats.NumDMLAffectedRows, true
+}
