+// ValidateWorkflowDryRun rejects capabilities beyond bounded ordinary-table SQL.
+func (s *Source) ValidateWorkflowDryRun(ctx context.Context, job *bigqueryrestapi.Job) error {
+ if job == nil || job.Statistics == nil || job.Statistics.Query == nil { return fmt.Errorf("missing dry run metadata") }
+ stats := job.Statistics.Query
+ allowed := stats.StatementType == "SELECT"
+ if s.WriteMode == WriteModeAllowed { allowed = stats.StatementType == "INSERT" || stats.StatementType == "UPDATE" || stats.StatementType == "DELETE" || stats.StatementType == "MERGE" }
+ if !allowed { return fmt.Errorf("statement type is not permitted by workflow action") }
+ if len(s.AllowedDatasets) == 0 { return fmt.Errorf("explicit dataset allowlist required") }
+ if len(stats.ReferencedRoutines) != 0 { return fmt.Errorf("stored routines unsupported") }
+ for _, table := range stats.ReferencedTables {
+  if table.ProjectId != s.Project || !s.IsDatasetAllowed(table.ProjectId, table.DatasetId) { return fmt.Errorf("table outside allowed project datasets") }
+  meta, err := s.Client.DatasetInProject(table.ProjectId, table.DatasetId).Table(table.TableId).Metadata(ctx)
+  if err != nil { return fmt.Errorf("unable to verify ordinary table") }
+  if meta.Type != bigqueryapi.RegularTable || meta.ExternalDataConfig != nil { return fmt.Errorf("only ordinary native tables are supported") }
+ }
+ return nil
+}
