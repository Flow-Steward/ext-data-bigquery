@@ -0,0 +1,60 @@
+package bigquery
+
+import (
+	bigqueryapi "cloud.google.com/go/bigquery"
+	"context"
+	bigqueryrestapi "google.golang.org/api/bigquery/v2"
+	"testing"
+)
+
+func TestFlowStewardDryRunPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		mode, kind string
+		allowed    bool
+	}{
+		{WriteModeBlocked, "SELECT", true}, {WriteModeBlocked, "DELETE", false},
+		{WriteModeAllowed, "SELECT", false}, {WriteModeAllowed, "DELETE", true},
+		{WriteModeAllowed, "INSERT", true}, {WriteModeAllowed, "UPDATE", true},
+		{WriteModeAllowed, "MERGE", true}, {WriteModeAllowed, "SCRIPT", false},
+		{WriteModeAllowed, "CREATE_TABLE", false},
+	} {
+		source := &Source{Config: Config{Project: "project", WriteMode: tc.mode}, AllowedDatasets: map[string]struct{}{"project.workflow": {}}}
+		job := &bigqueryrestapi.Job{Statistics: &bigqueryrestapi.JobStatistics{Query: &bigqueryrestapi.JobStatistics2{StatementType: tc.kind}}}
+		err := source.ValidateWorkflowDryRun(context.Background(), job)
+		if (err == nil) != tc.allowed {
+			t.Fatalf("mode=%s type=%s allowed=%v err=%v", tc.mode, tc.kind, tc.allowed, err)
+		}
+	}
+}
+func TestFlowStewardRejectsUnverifiedReferences(t *testing.T) {
+	source := &Source{Config: Config{Project: "project", WriteMode: WriteModeBlocked}, AllowedDatasets: map[string]struct{}{"project.workflow": {}}}
+	if source.ValidateWorkflowDryRun(context.Background(), nil) == nil {
+		t.Fatal("nil dry-run accepted")
+	}
+	job := &bigqueryrestapi.Job{Statistics: &bigqueryrestapi.JobStatistics{Query: &bigqueryrestapi.JobStatistics2{StatementType: "SELECT", ReferencedTables: []*bigqueryrestapi.TableReference{{ProjectId: "other", DatasetId: "workflow", TableId: "t"}}}}}
+	if source.ValidateWorkflowDryRun(context.Background(), job) == nil {
+		t.Fatal("cross-project reference accepted")
+	}
+	job.Statistics.Query.ReferencedTables = nil
+	job.Statistics.Query.ReferencedRoutines = []*bigqueryrestapi.RoutineReference{{ProjectId: "project", DatasetId: "workflow", RoutineId: "remote"}}
+	if source.ValidateWorkflowDryRun(context.Background(), job) == nil {
+		t.Fatal("stored routine accepted")
+	}
+	job.Statistics.Query.ReferencedRoutines = nil
+	job.Statistics.Query.ReferencedTables = make([]*bigqueryrestapi.TableReference, 50)
+	if source.ValidateWorkflowDryRun(context.Background(), job) == nil {
+		t.Fatal("incomplete reference metadata accepted")
+	}
+}
+func TestFlowStewardMergeCounters(t *testing.T) {
+	stats := &bigqueryapi.QueryStatistics{DMLStats: &bigqueryapi.DMLStatistics{InsertedRowCount: 2, UpdatedRowCount: 3, DeletedRowCount: 4}}
+	if count, known := workflowAffectedRows(stats, "MERGE"); !known || count != 9 {
+		t.Fatal("MERGE mutation counts lost")
+	}
+	if _, known := workflowAffectedRows(&bigqueryapi.QueryStatistics{}, "MERGE"); known {
+		t.Fatal("unknown MERGE count reported as zero")
+	}
+	if count, known := workflowAffectedRows(&bigqueryapi.QueryStatistics{NumDMLAffectedRows: 4}, "INSERT"); !known || count != 4 {
+		t.Fatal("INSERT count lost")
+	}
+}
