+package bigquerygettableinfo
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	bigqueryapi "cloud.google.com/go/bigquery"
+	bqsource "github.com/googleapis/mcp-toolbox/internal/sources/bigquery"
+	"github.com/googleapis/mcp-toolbox/internal/testutils"
+	"github.com/googleapis/mcp-toolbox/internal/tools"
+	"github.com/googleapis/mcp-toolbox/internal/util/parameters"
+	"google.golang.org/api/option"
+)
+
+type workflowTransport func(*http.Request) (*http.Response, error)
+
+func (f workflowTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func workflowFixture(t *testing.T, response func(*http.Request, int) string) (*Tool, *bqsource.Source, *int) {
+	t.Helper()
+	calls := new(int)
+	transport := workflowTransport(func(r *http.Request) (*http.Response, error) {
+		*calls++
+		if r.Method != "GET" || r.URL.Host != "bigquery.googleapis.com" {
+			t.Fatalf("unexpected provider request: %s %s", r.Method, r.URL)
+		}
+		body := response(r, *calls)
+		return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+	})
+	client, err := bigqueryapi.NewClient(context.Background(), "test-project", option.WithHTTPClient(&http.Client{Transport: transport}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close() })
+	source := &bqsource.Source{Config: bqsource.Config{Project: "test-project"}, Client: client, AllowedDatasets: map[string]struct{}{"test-project.workflow": {}, "other-project.workflow": {}}}
+	cfg := Config{ConfigBase: tools.ConfigBase{Name: "metadata", Description: "bounded metadata"}, Source: "s"}
+	tool, err := cfg.Initialize(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	actual := tool.(Tool)
+	return &actual, source, calls
+}
+
+func workflowParams(project, dataset string) parameters.ParamValues {
+	return parameters.ParamValues{{Name: "project", Value: project}, {Name: "dataset", Value: dataset}, {Name: "table", Value: "people"}}
+}
+
+func TestFlowStewardMetadataScopeBeforeWire(t *testing.T) {
+	tool, provider, calls := workflowFixture(t, func(*http.Request, int) string { t.Fatal("scope escaped"); return "" })
+	for _, params := range []parameters.ParamValues{workflowParams("other-project", "workflow"), workflowParams("test-project", "forbidden")} {
+		if _, err := tool.Invoke(workflowContext(t), provider, params, ""); err == nil {
+			t.Fatal("out of scope metadata accepted")
+		}
+	}
+	if *calls != 0 {
+		t.Fatal("out of scope request reached Google")
+	}
+}
+
+func TestFlowStewardTableMetadataWireAndJSONShape(t *testing.T) {
+	tool, provider, calls := workflowFixture(t, func(r *http.Request, n int) string {
+		if r.URL.Path != "/bigquery/v2/projects/test-project/datasets/workflow/tables/people" {
+			t.Fatalf("unexpected metadata path: %s", r.URL)
+		}
+		return `{"tableReference":{"projectId":"test-project","datasetId":"workflow","tableId":"people"},"type":"TABLE","schema":{"fields":[{"name":"name","type":"STRING","mode":"NULLABLE"}]}}`
+	})
+	value, err := tool.Invoke(workflowContext(t), provider, workflowParams("test-project", "workflow"), "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, marshalErr := json.Marshal(value)
+	if marshalErr != nil {
+		t.Fatal(marshalErr)
+	}
+	var shape map[string]any
+	if err := json.Unmarshal(encoded, &shape); err != nil {
+		t.Fatal(err)
+	}
+	if shape["Type"] != "TABLE" {
+		t.Fatalf("metadata type shape: %s", encoded)
+	}
+	columns := shape["Schema"].([]any)
+	if len(columns) != 1 || columns[0].(map[string]any)["Name"] != "name" {
+		t.Fatalf("schema shape: %s", encoded)
+	}
+	if *calls != 1 {
+		t.Fatalf("requests=%d", *calls)
+	}
+}
+
+func workflowContext(t *testing.T) context.Context {
+	t.Helper()
+	ctx, err := testutils.ContextWithNewLogger()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ctx
+}
